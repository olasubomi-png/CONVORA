# Server-only. Never expose these values to the browser.
# Copy this file to .env.local for local development.

# PostgreSQL connection string (Neon-compatible).
# Example Neon format:
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/convora

# Public origin of this application (no trailing slash).
APP_URL=http://localhost:3000

# Runtime environment.
NODE_ENV=development


# Base64-encoded 32-byte key for encrypting channel credentials (WhatsApp, Facebook, Instagram).
# Required in production.
CHANNEL_SECRETS_KEY=

# Optional Meta app identifiers for documentation / future OAuth (not required for token paste flow).
# META_APP_ID=
# META_APP_SECRET=


# Paystack (server-only secret — never expose to the browser)
PAYSTACK_SECRET_KEY=
# Public key may be used for client-side Paystack.js if needed
PAYSTACK_PUBLIC_KEY=

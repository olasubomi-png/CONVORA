# Server-only. Never expose secret values to the browser.
# Copy to .env.local for local development.

# --- Required ---
# PostgreSQL (Neon-compatible). Example:
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/convora

# Public origin of this application (no trailing slash).
APP_URL=http://localhost:3000

# development | test | production
NODE_ENV=development

# --- Required in production ---
# Base64-encoded 32-byte AES key for channel credential encryption.
# Generate: openssl rand -base64 32
CHANNEL_SECRETS_KEY=

# --- Optional: Paystack ---
# Server-only secret — never ship to the client.
PAYSTACK_SECRET_KEY=
# Client-safe public key (optional).
PAYSTACK_PUBLIC_KEY=

# --- Optional: AI ---
# AI_PROVIDER=openai|mock
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Channel provider tokens (WhatsApp / Facebook / Instagram) are stored
# encrypted per organization installation in the database, not here.

# Meta platform app (server-only). Required to connect WhatsApp / Messenger / Instagram.
# Create an app at https://developers.facebook.com/ — never commit real secrets.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration ID (required for OAuth)
META_LOGIN_CONFIG_ID=
# Aliases also accepted: META_CONFIG_ID, META_FACEBOOK_LOGIN_CONFIG_ID
# Optional override; defaults to ${APP_URL}/api/channels/meta/oauth/callback
META_REDIRECT_URI=
# Shared webhook verify token registered in the Meta app (server-only)
META_WEBHOOK_VERIFY_TOKEN=

# Media storage (production defaults to S3-compatible object storage)
# MEDIA_STORAGE_BACKEND=local|s3
# MEDIA_STORAGE_PATH=./.data/media
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# Web Push (optional — agent browser notifications)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Email notifications via Resend (optional)
# RESEND_API_KEY=
# EMAIL_FROM=CONVORA <noreply@example.com>
